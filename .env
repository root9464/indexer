# Cache Configuration
TON_PRICE_CACHE_TTL=60
BACKDROP_CACHE_TTL=1800
RESULTS_CACHE_TTL=300
MARKETCAP_CACHE_TTL=120
TRENDS_CACHE_TTL=90
FLOOR_PRICE_CACHE_TTL=180

# Session Storage
SESSION_PATH=session.json

# Frontend & Caddy Configuration
DOMAIN=durov.online
VITE_API_URL=/api
CADDY_EMAIL=admin@durov.online
CADDY_TLS_MODE=automatic
CADDY_GZIP=true
CADDY_SECURITY_HEADERS=true
CADDY_CACHE_STATIC_MAX_AGE=31536000
CADDY_CACHE_HTML_MAX_AGE=3600
CADDY_PROXY_TIMEOUT=60s
CADDY_PROXY_DIAL_TIMEOUT=30s
CADDY_HEALTH_CHECK_PATH=/health

# Vite Development Server Configuration
VITE_DEV_PORT=3000
VITE_DEV_HOST=true
VITE_ALLOWED_HOSTS=durov.online,localhost

# Build Configuration
VITE_BUILD_OUTDIR=dist
VITE_BUILD_ASSETSDIR=assets
VITE_BUILD_SOURCEMAP=false
VITE_BUILD_MINIFY=true
VITE_BUILD_TARGET=es2015
VITE_CHUNK_SIZE_WARNING_LIMIT=500

# React/Vite Environment Variables
REACT_APP_API_BASE_URL=/api
VITE_APP_TITLE=Gift Index
VITE_APP_VERSION=1.0.0

# Caddy Advanced Configuration
CADDY_AUTO_HTTPS=on
CADDY_LOG_LEVEL=INFO
CADDY_ADMIN_LISTEN=:2019
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_TLS_PROTOCOLS=tls1.2,tls1.3
CADDY_OCSP_STAPLING=on
CADDY_MUST_STAPLE=off

# Security Headers Configuration
CADDY_HSTS_MAX_AGE=31536000
CADDY_HSTS_INCLUDE_SUBDOMAINS=true
CADDY_HSTS_PRELOAD=true
CADDY_FRAME_OPTIONS=DENY
CADDY_CONTENT_TYPE_OPTIONS=nosniff
CADDY_REFERRER_POLICY=strict-origin-when-cross-origin

# Compression Configuration
CADDY_GZIP_LEVEL=6
CADDY_COMPRESSION_TYPES=text/html,text/css,text/javascript,application/javascript,application/json,image/svg+xml

# Proxy Configuration
CADDY_REVERSE_PROXY_RETRIES=3
CADDY_REVERSE_PROXY_TRY_DURATION=5s
CADDY_REVERSE_PROXY_TRY_INTERVAL=250ms
CADDY_REVERSE_PROXY_HEALTH_INTERVAL=30s
CADDY_REVERSE_PROXY_HEALTH_TIMEOUT=10s

# Static File Serving
CADDY_FILE_SERVER_HIDE=.git,.env,.env.*,Dockerfile,docker-compose.yml,*.md
CADDY_FILE_SERVER_INDEX=index.html
CADDY_FILE_SERVER_BROWSE=false
CADDY_FILE_SERVER_PRECOMPRESSED=gzip

# Rate Limiting
CADDY_RATE_LIMIT_ZONE=api
CADDY_RATE_LIMIT_WINDOW=1m
CADDY_RATE_LIMIT_REQUESTS=100
CADDY_RATE_LIMIT_BURST=20

# Docker Build Configuration
DOCKER_BUILDKIT=1
DOCKER_FRONTEND_BUILD_ARGS=--no-cache
DOCKER_FRONTEND_TARGET=production
DOCKER_CADDY_VERSION=2-alpine
DOCKER_NODE_VERSION=22-alpine

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3
HEALTH_CHECK_START_PERIOD=15s
HEALTH_CHECK_ENDPOINT=/health

# Logging Configuration
LOG_FORMAT=json
LOG_MAX_SIZE=10m
LOG_MAX_FILES=3
LOG_COMPRESS=true
LOG_ROTATE_DAILY=true
